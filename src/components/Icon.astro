---
interface Props {
  name:
    | "arrow-left"
    | "arrow-right"
    | "arrow-up-right"
    | "check"
    | "chevron-down"
    | "circle"
    | "code-compare"
    | "menu"
    | "plus"
    | "robot"
    | "search"
    | "sparkles";
  class?: string;
}

const { name, class: className = "" } = Astro.props;
---

<svg class:list={["icon", className]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "arrow-left" && <path d="M19 12H5m0 0 6 6m-6-6 6-6" />}
  {name === "arrow-right" && <path d="M5 12h14m0 0-6-6m6 6-6 6" />}
  {name === "arrow-up-right" && <path d="M7 17 17 7M8 7h9v9" />}
  {name === "check" && <path d="m5 12 4 4L19 6" />}
  {name === "chevron-down" && <path d="m6 9 6 6 6-6" />}
  {name === "circle" && <circle cx="12" cy="12" r="3.5" />}
  {name === "code-compare" && <><path d="M7 7h12l-3-3m3 3-3 3" /><path d="M17 17H5l3-3m-3 3 3 3" /></>}
  {name === "menu" && <><path d="M4 7h16M4 12h16M4 17h16" /></>}
  {name === "plus" && <path d="M12 5v14m-7-7h14" />}
  {name === "robot" && <><rect x="4" y="7" width="16" height="13" rx="3" /><path d="M12 4v3m-4 5h.01M16 12h.01M9 16h6" /><path d="M2 11v5m20-5v5" /></>}
  {name === "search" && <><circle cx="10.8" cy="10.8" r="6.3" /><path d="m15.5 15.5 4.2 4.2" /></>}
  {name === "sparkles" && <><path d="m12 3 1.9 5.8L20 11l-6.1 2.2L12 19l-1.9-5.8L4 11l6.1-2.2L12 3Z" /><path d="m19 14 .9 2.1L22 17l-2.1.9L19 20l-.9-2.1L16 17l2.1-.9L19 14Z" /></>}
</svg>
