---
interface Props {
  sourceLabel: string;
  sourceLanguage: string;
  source: string;
  targetLabel: string;
  targetLanguage: string;
  target: string;
}

const { sourceLabel, sourceLanguage, source, targetLabel, targetLanguage, target } = Astro.props;
---

<section class="code-compare" aria-label={`${sourceLabel} 与 ${targetLabel} 代码对照`}>
  <div class="compare-header">
    <span class="eyebrow">TRANSLATION LENS</span>
    <span class="compare-hint">同一个意图，两种工程表达</span>
  </div>
  <div class="compare-grid">
    <div class="code-pane">
      <div class="code-pane-header"><span class="language-dot source"></span>{sourceLabel}<button class="copy-button" data-copy-code data-code={source} type="button">复制</button></div>
      <pre><code class={`language-${sourceLanguage}`}>{source}</code></pre>
    </div>
    <div class="compare-arrow" aria-hidden="true">→</div>
    <div class="code-pane target-pane">
      <div class="code-pane-header"><span class="language-dot target"></span>{targetLabel}<button class="copy-button" data-copy-code data-code={target} type="button">复制</button></div>
      <pre><code class={`language-${targetLanguage}`}>{target}</code></pre>
    </div>
  </div>
</section>
