---
interface Props {
  title?: string;
  label?: string;
}

const { title = "迁移提示", label = "KEY IDEA" } = Astro.props;
---

<aside class="key-idea">
  <div class="key-idea-icon" aria-hidden="true">✦</div>
  <div>
    <span class="eyebrow">{label}</span>
    <h3>{title}</h3>
    <div class="key-idea-content"><slot /></div>
  </div>
</aside>
