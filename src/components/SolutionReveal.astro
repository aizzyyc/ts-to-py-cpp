---
import Icon from "./Icon.astro";

interface Props {
  title?: string;
}

const { title = "本节结论" } = Astro.props;
---

<details class="solution-reveal" data-lesson-section="conclusion">
  <summary><span>{title}</span><Icon name="chevron-down" class="summary-arrow" /></summary>
  <div class="solution-content"><slot /></div>
</details>
