---
import { sitePath } from "../lib/site-path";
import { getPrimaryNavSection } from "../lib/primary-navigation";
import Icon from "./Icon.astro";

const pathname = Astro.url.pathname;
const currentSection = getPrimaryNavSection(pathname, import.meta.env.BASE_URL);
---

<header class="site-header">
  <div class="page-container header-inner">
    <a class="brand" href={sitePath("/")} aria-label="LangShift 首页">
      <span class="brand-mark">L</span>
      <span>Lang<span class="brand-accent">Shift</span></span>
    </a>
    <nav class="desktop-nav" aria-label="主导航">
      <a
        class={currentSection === "learn" ? "is-active" : undefined}
        aria-current={currentSection === "learn" ? "page" : undefined}
        href={sitePath("/learn")}
      >学习路线</a>
      <a
        class={currentSection === "search" ? "is-active" : undefined}
        aria-current={currentSection === "search" ? "page" : undefined}
        href={sitePath("/search")}
      >搜索课程</a>
      <a href={sitePath("/#method")} data-nav-method>学习方法</a>
    </nav>
    <button class="mobile-menu-toggle" type="button" data-mobile-menu-toggle aria-expanded="false" aria-controls="mobile-nav">
      <Icon name="menu" class="mobile-menu-icon" />
      <span>菜单</span>
    </button>
    <div class="header-actions">
      <a class="header-search" href={sitePath("/search")} aria-label="搜索课程">
        <Icon name="search" class="search-glyph" />
        <span class="search-label">搜索</span>
        <kbd>/</kbd>
      </a>
      <a class="button button-small button-dark" href={sitePath("/learn")}>开始学习 <Icon name="arrow-up-right" /></a>
    </div>
  </div>
  <nav id="mobile-nav" class="mobile-nav" data-mobile-nav hidden aria-label="移动端主导航">
    <a class={currentSection === "learn" ? "is-active" : undefined} aria-current={currentSection === "learn" ? "page" : undefined} href={sitePath("/learn")}>学习路线</a>
    <a class={currentSection === "search" ? "is-active" : undefined} aria-current={currentSection === "search" ? "page" : undefined} href={sitePath("/search")}>搜索课程</a>
    <a href={sitePath("/#method")} data-nav-method>学习方法</a>
  </nav>
</header>

<script>
  import { isCurrentHashTarget } from "../lib/primary-navigation";

  const syncMethodNavigation = () => {
    document.querySelectorAll<HTMLAnchorElement>("[data-nav-method]").forEach((methodLink) => {
      const target = new URL(methodLink.href, window.location.href);
      const isCurrent = isCurrentHashTarget(
        window.location.pathname,
        window.location.hash,
        target.pathname,
        target.hash,
      );

      methodLink.classList.toggle("is-active", isCurrent);
      if (isCurrent) methodLink.setAttribute("aria-current", "location");
      else methodLink.removeAttribute("aria-current");
    });

    if (window.location.hash === "#method") {
      window.requestAnimationFrame(() => {
        document.getElementById("method")?.scrollIntoView({ block: "start" });
      });
    }
  };

  const closeMobileMenu = () => {
    const menuToggle = document.querySelector<HTMLButtonElement>("[data-mobile-menu-toggle]");
    const mobileNav = document.querySelector<HTMLElement>("[data-mobile-nav]");
    if (!menuToggle || !mobileNav) return;
    mobileNav.hidden = true;
    menuToggle.setAttribute("aria-expanded", "false");
  };

  document.addEventListener("astro:page-load", syncMethodNavigation);
  window.addEventListener("hashchange", syncMethodNavigation);
  window.addEventListener("pageshow", syncMethodNavigation);

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const menuToggle = target.closest<HTMLButtonElement>("[data-mobile-menu-toggle]");
    if (menuToggle) {
      const mobileNav = document.querySelector<HTMLElement>("[data-mobile-nav]");
      if (!mobileNav) return;
      const isOpen = !mobileNav.hidden;
      mobileNav.hidden = isOpen;
      menuToggle.setAttribute("aria-expanded", String(!isOpen));
      return;
    }

    if (target.closest("[data-mobile-nav] a")) closeMobileMenu();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMobileMenu();
  });
</script>
