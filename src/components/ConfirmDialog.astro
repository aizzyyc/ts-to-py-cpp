<dialog
  class="confirm-dialog"
  data-confirm-dialog
  aria-labelledby="confirm-dialog-title"
  aria-describedby="confirm-dialog-message"
>
  <div class="confirm-dialog-content">
    <h2 id="confirm-dialog-title" data-confirm-title>请确认</h2>
    <p id="confirm-dialog-message" data-confirm-message></p>
    <div class="confirm-dialog-actions">
      <button class="confirm-dialog-button confirm-dialog-button-secondary" type="button" data-confirm-cancel>取消</button>
      <button class="confirm-dialog-button confirm-dialog-button-primary" type="button" data-confirm-accept>确定</button>
    </div>
  </div>
</dialog>
