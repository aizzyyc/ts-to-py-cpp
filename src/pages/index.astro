---
import BaseLayout from "../layouts/BaseLayout.astro";
import { LESSONS } from "../lib/lessons";
import { sitePath } from "../lib/site-path";
import { DEBUGGING_STEPS, REVIEW_GUIDANCE, STUDY_STEPS } from "../lib/study-method";

const totalLessons = LESSONS.length;
---

<BaseLayout>
  <section class="hero">
    <div class="page-container hero-grid">
      <div>
        <span class="eyebrow">A FASTER WAY TO GO POLYGLOT</span>
        <h1>把熟悉的 <em>JS/TS</em>，变成新的工程能力。</h1>
        <p class="hero-lead">为已经会做项目的开发者设计。用你熟悉的语言做参照，快速进入 Python、C++，再走向 AI 和机器人。</p>
        <div class="hero-actions">
          <a class="button button-dark" href={sitePath("/learn")}>开始探索路线 <span aria-hidden="true">↗</span></a>
          <a class="button button-light" href="#method">了解学习方法</a>
        </div>
        <p class="hero-note">{totalLessons} 节短课 · 中文解释 · 每节 8–18 分钟 · 本地保存进度</p>
        <div class="hero-stats" aria-label="网站特点">
          <div class="hero-stat"><strong>{totalLessons}</strong><span>节迁移课程</span></div>
          <div class="hero-stat"><strong>2</strong><span>条行业路线</span></div>
          <div class="hero-stat"><strong>0</strong><span>无意义的绕路</span></div>
        </div>
      </div>
      <div class="hero-visual" aria-label="JavaScript、Python 和 C++ 连接到 AI 与机器人的抽象插图">
        <div class="visual-orbit"></div>
        <div class="visual-core"><span>→</span></div>
        <div class="float-label python">Python / AI</div>
        <div class="float-label cpp">C++ / Robotics</div>
        <div class="float-label js">JS / TS</div>
      </div>
    </div>
  </section>

  <section class="section" id="paths">
    <div class="page-container">
      <div class="section-heading">
        <div><span class="eyebrow">CHOOSE YOUR DIRECTION</span><h2>先选目标，再学语言。</h2></div>
        <p>共同基础只学一次。之后按你想进入的现场，选择 Python 或 C++ 的实践路线。</p>
      </div>
      <div class="goal-grid">
        <a class="goal-card" href={sitePath("/learn?goal=ai")} data-goal="ai">
          <div><div class="goal-icon" aria-hidden="true">⌁</div><h3>AI 工程路径</h3><p>先完成 JS/TS → Python 迁移基础，再进入数据、模型和 AI 服务工程。</p></div>
          <span class="goal-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="goal-card robotics" href={sitePath("/learn?goal=robotics")} data-goal="robotics">
          <div><div class="goal-icon" aria-hidden="true">⊙</div><h3>机器人路径</h3><p>先完成 JS/TS → C++ 迁移基础，再进入消息、实时性和 ROS 2 工程。</p></div>
          <span class="goal-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section method-section" id="method">
    <div class="page-container">
      <div class="section-heading">
        <div><span class="eyebrow">A PRACTICAL 35 MINUTE ROUTINE</span><h2>一节课，走完一轮迁移练习。</h2></div>
        <p>不必重学编程入门。用熟悉的 JS/TS 做参照，亲手运行新语言，再用练习和回忆确认自己真的掌握。</p>
      </div>
      <ol class="method-grid" aria-label="一节课程的学习步骤">
        {STUDY_STEPS.map((step) => (
          <li class="method-item">
            <div class="method-item-meta">
              <span class="method-index">{step.number} / {step.label}</span>
              <span class="method-duration">{step.minutes} 分钟</span>
            </div>
            <h3>{step.title}</h3>
            <p>{step.action}</p>
            <p class="method-output"><strong>本步产出：</strong>{step.output}</p>
          </li>
        ))}
      </ol>
      <div class="method-support-grid">
        <section class="method-support-card method-debug">
          <h3>卡住时，按这个顺序排查</h3>
          <ol class="method-debug-list">
            {DEBUGGING_STEPS.map((step) => <li>{step}</li>)}
          </ol>
        </section>
        <aside class="method-support-card method-review">
          <h3>学完后这样巩固</h3>
          <p>{REVIEW_GUIDANCE}</p>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
