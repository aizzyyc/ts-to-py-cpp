---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContinueLearning from "../../components/ContinueLearning.astro";
import ProgressIndicator from "../../components/ProgressIndicator.astro";
import RouteSidebar from "../../components/RouteSidebar.astro";
import { getCoursePhases, getPhaseLessons } from "../../lib/course-flow";
import { LESSONS, type Track } from "../../lib/lessons";

const tracks: Track[] = ["common", "python", "cpp"];
---

<BaseLayout title="学习路线 · LangShift">
  <section class="learn-hero">
    <div class="page-container learn-hero-row">
        <div><span class="eyebrow">YOUR LEARNING PATH</span><h1>从 JS/TS 出发，走到新的现场。</h1><p>选择一条路径，先完成对应语言的迁移基础，再进入 AI 或机器人专项。每节课都短、具体，并且有一个可以马上动手的小练习。</p></div>
      <ProgressIndicator total={LESSONS.length} />
    </div>
  </section>
  <section class="learn-content">
    <div class="page-container">
      <div class="route-mode" data-route-mode hidden>
        <div><span class="eyebrow">CURRENT PATH</span><strong data-route-mode-label></strong><span data-route-mode-copy>语言迁移基础 + 专项内容</span></div>
        <a href="/learn" data-clear-goal>查看全部路线</a>
      </div>
      <ContinueLearning />
      <div class="learn-layout">
        <RouteSidebar lessons={LESSONS} />
        <div>
         {tracks.map((track) => {
            const trackLessons = LESSONS.filter((lesson) => lesson.track === track).sort((a, b) => a.order - b.order);
            const phases = getCoursePhases(track);
            return <section class="track-section" id={track} data-track={track}>
              {phases.map((phase) => {
                const lessons = getPhaseLessons(trackLessons, phase);
                const checkpointLesson = phase.checkpointLessonId ? lessons.find((lesson) => lesson.id === phase.checkpointLessonId) : undefined;
                const duration = lessons.reduce((total, lesson) => total + lesson.durationMinutes, 0);
                return <div class:list={["track-subsection", { "phase-project": phase.project }]} data-phase-id={phase.id} data-phase-track={track}>
                  <div class="track-section-header">
                    <div class="track-title-wrap"><span class:list={["track-dot", track]}></span><div><span class="phase-kind">{phase.project ? "结课项目" : "学习阶段"}</span><h2>{phase.title}</h2><p>{phase.description}</p></div></div>
                    <span class="track-count">{lessons.length} LESSONS</span>
                  </div>
                  <div class="phase-meta">
                    <span data-phase-progress data-phase-total={lessons.length}>0/{lessons.length}</span>
                    <span>{duration} 分钟</span>
                    {checkpointLesson && <span class="phase-checkpoint">阶段检查：{checkpointLesson.title}</span>}
                  </div>
                  <div class="phase-progress-bar" aria-hidden="true"><span data-phase-bar></span></div>
                  <div class="course-list">
                    {lessons.map((lesson) => <a class="course-row" href={`/learn/${lesson.track}/${lesson.slug}`} data-lesson-id={lesson.id}>
                      <span class="course-index">{String(lesson.order).padStart(2, "0")}</span>
                      <span class="course-copy"><h3>{lesson.title}</h3><p>{lesson.summary}</p></span>
                      <span class="course-tags">{lesson.concepts.slice(0, 2).map((concept) => <span class="tag">{concept}</span>)}</span>
                      <span class="course-arrow" aria-hidden="true">↗</span>
                    </a>)}
                  </div>
                </div>;
              })}
            </section>;
         })}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
